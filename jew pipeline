pipeline {
    agent any

    environment {
        DEPLOY_DIR = '/opt/imsapp'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/ryanrennie/ims.git'
            }
        }

        stage('Check Tools') {
            steps {
                sh 'docker ps'
                sh 'node -v && npm -v'
            }
        }

        stage('Build & Test Backend (imsapi)') {
            steps {
                dir('imsapi') {
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package'
                }
            }
        }

        stage('Build Frontend (ui)') {
            steps {
                dir('ui') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy Locally') {
            steps {
                sh """
                    mkdir -p ${DEPLOY_DIR}
                    rsync -av --delete \
                        --exclude '.git' \
                        --exclude 'ui/node_modules' \
                        --exclude '.env' \
                        --exclude 'imsapi/.env' \
                        ./ ${DEPLOY_DIR}/
                    cd ${DEPLOY_DIR} &&
                    docker compose up -d --build --remove-orphans &&
                    docker image prune -f
                """
            }
        }
    }
}
