pipeline {
    agent any

    environment {
        DEPLOY_DIR = '/opt/imsapp'
    }

    stages {
        stage('Deploy Locally') {
            steps {
                sh """
                    mkdir -p "${DEPLOY_DIR}"
                    rsync -av --delete \
                        --exclude '.git' \
                        --exclude '*@tmp' \
                        --exclude 'ui/node_modules' \
                        --exclude '.env' \
                        ./ "${DEPLOY_DIR}/"
                    cd "${DEPLOY_DIR}" &&
                    docker compose up -d --build --remove-orphans &&
                    docker image prune -f
                """
            }
        }
    }
}
