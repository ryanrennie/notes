CHANGES

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/ryanrennie/ims.git'
            }
        }
        
        stage('Build & Test Backend (imsapi)') {
            steps {
                dir('imsapi') {
                    // Assuming Maven wrapper is present; use 'mvn clean package' if using global Maven
                    sh './mvnw clean package'
                }
            }
        }

        stage('Build & Test Frontend (ui)') {
            steps {
                dir('ui') {
                    // Install dependencies and build/test the React application
                    sh 'npm install'
                    sh 'npm run build'
                    // Uncomment the line below if you have automated tests configured (e.g., Jest/React Testing Library)
                    // sh 'npm test -- --watchAll=false'
                }
            }
        }
    }
}
