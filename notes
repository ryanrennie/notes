pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/ryanrennie/ims.git'
            }
        }
    }
}



CHANGES

pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/ryanrennie/ims.git'
            }
        }
        
        stage('Build & Test Backend (imsapi)') {
            steps {
                dir('imsapi') {
                    // Grant execution rights to the Maven wrapper script
                    sh 'chmod +x ./mvnw'
                    sh './mvnw clean package'
                }
            }
        }

        stage('Build & Test Frontend (ui)') {
            steps {
                dir('ui') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
    }
}
